PORT=3001
NODE_ENV=development
# CORS_ORIGIN=http://localhost:5173

# PostgreSQL (required)
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/lattice_ai
# Example (no password): postgresql://sriram@localhost:5432/lattice_ai

# Requirement Analyzer — Vertex AI (Gemini) preferred
# Project ID from Google Cloud Console (or Google AI Studio)
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# VERTEX_PROJECT_ID=your-gcp-project-id
# GOOGLE_CLOUD_LOCATION=us-central1
# VERTEX_MODEL=gemini-1.5-flash

# Gemini API key (Google AI Studio) — alternative to Vertex AI
# Get from https://aistudio.google.com/app/apikey
# GEMINI_API_KEY=your-gemini-api-key

# Fallback: OpenAI (used if Vertex/Gemini is not configured or fails)
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# Materials Project (optional) — for material search. Get key from https://next-gen.materialsproject.org/api
# Without this, curated materials (Al 7075, PA12-CF, Ti-6Al-4V) are used.
# MP_API_KEY=your-mp-api-key
